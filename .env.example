# Copy to .env and fill in. Never commit .env.

# Required for the enrich stage (S5)
ANTHROPIC_API_KEY=

# Optional: override the default Claude model
# ANTHROPIC_MODEL=claude-haiku-4-5

# Conversation partner (spikes + v1)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# ElevenLabs — ear test only (spike S2)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Deepgram — third STT candidate (spike S1b)
DEEPGRAM_API_KEY=
# OpenAI-compatible multi-model gateway (spike S3)
GATEWAY_BASE_URL=
GATEWAY_API_KEY=

# Conversation partner (v1) — required for `stc talk`
# ';'-separated absolute paths, read in place, never copied into the repo
STC_QUESTION_BANKS=
# Optional overrides (defaults shown)
# STC_PARTNER_MODEL=deepseek-v4-pro
# STC_FALLBACK_MODEL=claude-sonnet-5
# STC_TTS_VOICE=de-DE-SeraphinaMultilingualNeural
# STC_LADDER_SECONDS=4,8,12
